{
  "Api": {
    "DefinitionsDir": "Definitions\\Api",
    "OutputDir": "Apis",
    "Namespace": "Osdu.Client.Apis"
  },
  "Schema": {
    "DefinitionsDir": "Definitions\\Schema",
    "OutputDir": "Schemas",
    "Namespace": "Osdu.Client.Schemas"
  },
  "Extension": {
    "OutputDir": "Extensions",
    "Namespace": "Osdu.Client.Extensions"
  },
  "Converter": {
    "OutputDir": "Converters",
    "Namespace": "Osdu.Client.Converters"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../logs/osdu.client.generator_.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{Exception}{NewLine}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
