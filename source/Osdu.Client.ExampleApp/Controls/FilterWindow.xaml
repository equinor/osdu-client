<Window x:Class="Osdu.Client.ExampleApp.Controls.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Osdu.Client.ExampleApp.Controls"
        Title="Filter Query Builder"
        Width="900" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="🔍 Filter Builder" FontSize="15" FontWeight="SemiBold"
                         VerticalAlignment="Center" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                    <CheckBox x:Name="ManualModeCheck" Content="Advanced (Manual Query)"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            Checked="ManualModeCheck_Changed" Unchecked="ManualModeCheck_Changed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Property Browser -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="12"
                         DockPanel.Dock="Top" Margin="0,0,0,4" Tag="secondary" />
                <TreeView x:Name="PropertyTree" BorderThickness="1" Padding="2"
                        FontSize="12" />
            </DockPanel>

            <!-- Right: Conditions Builder or Manual Query -->
            <Grid Grid.Column="1">
                <!-- Visual Builder -->
                <DockPanel x:Name="VisualBuilderPanel">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Conditions" FontWeight="SemiBold" FontSize="12"
                                 VerticalAlignment="Center" DockPanel.Dock="Left" Tag="secondary" />
                        <Button Content="＋ Add Condition" Click="AddCondition_Click"
                              Padding="8,3" Margin="8,0,0,0" FontSize="11"
                              DockPanel.Dock="Left" VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ConditionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="#CCCCCC" CornerRadius="3"
                                          Margin="0,0,0,4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Enable/Disable -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                                    ToolTip="Enable/Disable this condition" />

                                            <!-- Property -->
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProperties}"
                                                    SelectedItem="{Binding PropertyPath, Mode=TwoWay}"
                                                    IsEditable="True" FontSize="11" Margin="0,0,4,0"
                                                    FontFamily="Cascadia Code,Consolas"
                                                    ToolTip="Select property" />

                                            <!-- Operator -->
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Operators}"
                                                    SelectedItem="{Binding Operator, Mode=TwoWay}"
                                                    Width="140" FontSize="11" Margin="0,0,4,0"
                                                    ToolTip="Select operator" />

                                            <!-- Value -->
                                            <TextBox Grid.Column="3" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                   FontSize="11" VerticalContentAlignment="Center"
                                                   Margin="0,0,4,0" Padding="4,3"
                                                   ToolTip="Enter value" />

                                            <!-- Remove -->
                                            <Button Grid.Column="4" Content="✕" Click="RemoveCondition_Click"
                                                  Width="24" Height="24" FontSize="12"
                                                  Padding="0" ToolTip="Remove condition" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Manual Query Editor (hidden by default) -->
                <DockPanel x:Name="ManualQueryPanel" Visibility="Collapsed">
                    <TextBlock Text="Enter Lucene Query (type to see suggestions)"
                             FontSize="12" DockPanel.Dock="Top" Margin="0,0,0,6" Tag="secondary" />
                    <Grid>
                        <TextBox x:Name="ManualQueryBox" AcceptsReturn="True"
                               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                               FontFamily="Cascadia Code,Consolas" FontSize="13"
                               Padding="8,6" MinHeight="200"
                               TextChanged="ManualQueryBox_TextChanged"
                               PreviewKeyDown="ManualQueryBox_PreviewKeyDown" />
                        <Popup x:Name="IntellisensePopup" Placement="RelativePoint"
                             StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                                  CornerRadius="2" Padding="2" MaxHeight="200">
                                <ListBox x:Name="IntellisenseList" MinWidth="200"
                                       FontFamily="Cascadia Code,Consolas" FontSize="12"
                                       MouseDoubleClick="IntellisenseList_MouseDoubleClick"
                                       BorderThickness="0" />
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Query Preview -->
        <Border Grid.Row="2" Margin="12,4,12,8" Padding="8,6"
              BorderThickness="1" BorderBrush="#CCCCCC" CornerRadius="3">
            <DockPanel>
                <TextBlock Text="Preview:" FontWeight="SemiBold" FontSize="12"
                         VerticalAlignment="Top" DockPanel.Dock="Left" Margin="0,0,8,0" Tag="secondary" />
                <TextBox x:Name="QueryPreviewBox" IsReadOnly="True" TextWrapping="Wrap"
                       BorderThickness="0" FontFamily="Cascadia Code,Consolas"
                       FontSize="12" Background="Transparent" Text="(no filter)" />
            </DockPanel>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="#CCCCCC">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear Filter" Click="Clear_Click" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="Cancel" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="Apply Filter" Click="Apply_Click" Padding="12,6"
                      FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
