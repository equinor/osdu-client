<UserControl x:Class="Osdu.Client.ExampleApp.Controls.TreeViewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Osdu.Client.ExampleApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <ComboBox x:Name="RecordSelector"
                  DockPanel.Dock="Top"
                  Margin="8"
                  SelectionChanged="RecordSelector_SelectionChanged" />
        <TreeView x:Name="JsonTree"
                  BorderThickness="0"
                  Padding="4" />
    </DockPanel>
</UserControl>
