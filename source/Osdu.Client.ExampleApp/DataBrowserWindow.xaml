<Window x:Class="Osdu.Client.ExampleApp.DataBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Osdu.Client.ExampleApp"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:Osdu.Client.ExampleApp.Controls"
        Title="Osdu Data Browser"
        Width="1400" Height="850"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Toolbar -->
        <ToolBar x:Name="MainToolbar" DockPanel.Dock="Top" Height="36">
            <Button x:Name="RefreshButton" Content="⟳ Refresh Kinds" Click="RefreshButton_Click"
                    Padding="8,2" Margin="4,0" />
            <Separator />
            <Button x:Name="FetchAllButton" Content="⬇ Fetch All" Click="FetchAllButton_Click"
                    Padding="8,2" Margin="4,0" IsEnabled="False" />
            <Separator />
            <ToggleButton x:Name="ThemeToggle" Content="🌙 Dark" Click="ThemeToggle_Click"
                          Padding="8,2" Margin="4,0" />
        </ToolBar>

        <!-- StatusBar -->
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Height="26">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="RecordCountText" Text="" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="ProgressBar" Width="120" Height="14"
                             IsIndeterminate="False" Visibility="Collapsed" />
            </StatusBarItem>
        </StatusBar>

        <!-- Content: Split Panel -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Kind Tree -->
            <controls:KindTreeControl x:Name="KindTree" Grid.Column="0" />

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Right: Tabs -->
            <TabControl x:Name="ContentTabs" Grid.Column="2" Margin="0">
                <TabItem Header="Raw">
                    <controls:RawViewControl x:Name="RawView" />
                </TabItem>
                <TabItem Header="Tabular">
                    <controls:TabularViewControl x:Name="TabularView" />
                </TabItem>
                <TabItem Header="Tree">
                    <controls:TreeViewTab x:Name="TreeView" />
                </TabItem>
            </TabControl>

            <!-- Paging overlay on right panel bottom -->
            <DockPanel Grid.Column="2" VerticalAlignment="Bottom"
                       HorizontalAlignment="Center" Margin="0,0,0,8">
                <Button x:Name="PrevPageButton" Content="◄ Prev" Click="PrevPage_Click"
                        Padding="10,4" Margin="4,0" IsEnabled="False" />
                <TextBlock x:Name="PageInfoText" VerticalAlignment="Center"
                           Margin="8,0" FontSize="12" />
                <Button x:Name="NextPageButton" Content="Next ►" Click="NextPage_Click"
                        Padding="10,4" Margin="4,0" IsEnabled="False" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

