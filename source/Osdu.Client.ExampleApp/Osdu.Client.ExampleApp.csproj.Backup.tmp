<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UserSecretsId>55b978a3-6edf-48a2-a246-204b25d233ae</UserSecretsId>
    </PropertyGroup>

    <Target Name="CopyApiDefinitions" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <ApiDefinitionFiles Include="$(ProjectDir)..\Osdu.Client.Generator.ConsoleApp\Definitions\Api\*.json" />
        </ItemGroup>
        <Copy SourceFiles="@(ApiDefinitionFiles)" DestinationFolder="$(OutputPath)Definitions\Api" SkipUnchangedFiles="false" />
    </Target>

    <ItemGroup>
      <Compile Remove="Caching\**" />
      <Compile Remove="Query\**" />
      <EmbeddedResource Remove="Caching\**" />
      <EmbeddedResource Remove="Query\**" />
      <None Remove="Caching\**" />
      <None Remove="Query\**" />
      <Page Remove="Caching\**" />
      <Page Remove="Query\**" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Examples\Caching\CachePerformanceExample.cs" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Caching\CachePerformanceExample.cs">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Storage\GetRecordsExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Storage\PostRecordsDeleteByIdExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\WellboreDdms\PostDdmsV3WelllogsExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="ExamplesBuilder\IExample.cs" />
        <Content Include="Examples\Entitlement\GetInfoExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Entitlement\GetGroupsExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Indexer\GetInfoExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Legal\GetLegalTagsPropertiesExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Legal\GetLegalTagsExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Schema\GetInfoExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Schema\GetSchemaExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Search\PostQueryExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Search\PostQueryWellLogsExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\Storage\GetRecordsByIdExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\WellboreDdms\PostDdmsV3WellboresExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\WellboreDdms\GetAboutExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Examples\WellboreDdms\GetVersionExample.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
        <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Osdu.Client.Extensions\Osdu.Client.Extensions.csproj" />
        <ProjectReference Include="..\Osdu.Client\Osdu.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Examples\Dataset\" />
        <Folder Include="Examples\File\" />
        <Folder Include="Examples\Notification\" />
        <Folder Include="Examples\Partition\" />
        <Folder Include="Examples\Policy\" />
        <Folder Include="Examples\RafsDdms\" />
        <Folder Include="Examples\Register\" />
        <Folder Include="Examples\Unit\" />
        <Folder Include="Examples\CrsConversion\" />
        <Folder Include="Examples\CrsCatalog\" />
    </ItemGroup>

</Project>